# Where Pano answers (the /api suffix is optional).
API_URL=http://localhost:8088/api
# Panel -> Appearance -> Themes -> gear button ("Site display settings") -> "Site connection keys" -> Manage -> create one, paste it here.
# Without it the site still shows public pages, but login and register are refused.
PANO_FRONTEND_KEY=
# Public address of this site (supplied by Pano in custom-app mode).
PANO_SITE_URL=http://localhost:5173
# Behind your own reverse proxy (nginx, Caddy, Traefik, Docker port mapping): the proxy addresses whose X-Forwarded-For
# header tells the visitor's IP, comma separated; the words "loopback" and "private" cover those ranges. Leave it empty
# when the site is reached directly. A custom app run by Pano trusts loopback by itself.
TRUSTED_PROXIES=
