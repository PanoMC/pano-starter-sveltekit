    "schemas": {
      "Error": {
        "description": "The body of every non-2xx answer.",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "A stable, declared code.",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "description": "Extra facts about the failure.",
                "type": "object"
              },
              "fields": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field name to code, for a rejected form.",
                "type": "object"
              },
              "message": {
                "description": "Optional English text.",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "description": "Where a list stands: page numbers start at 1, `pageSize` is at most 100.",
        "properties": {
          "number": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The public API of the plugin pano-plugin-staff-page, served below /api/plugins/pano-plugin-staff-page.",
    "summary": "Pano plugin API: pano-plugin-staff-page",
    "title": "Pano plugin API: pano-plugin-staff-page",
    "version": "1",
    "x-pano-api-level": 1,
    "x-pano-plugin-id": "pano-plugin-staff-page",
    "x-pano-scope": "plugin"
  },
  "openapi": "3.1.0",
  "paths": {
    "/staff/config": {
      "get": {
        "operationId": "ThemeGetConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "displayLocation": {
                      "type": "string"
                    },
                    "pageUrl": {
                      "type": "string"
                    },
                    "viewMode": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "displayLocation",
                    "pageUrl",
                    "viewMode"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "How the staff page is shown: its address, layout and place.",
        "tags": [
          "staff"
        ],
        "x-pano-stability": "public"
      }
    },
    "/staffs": {
      "get": {
        "operationId": "ThemeGetStaff",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "properties": {
                          "avatarUrl": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "createdAt": {
                            "type": "integer"
                          },
                          "description": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "priority": {
                            "type": "integer"
                          },
                          "role": {
                            "type": "string"
                          },
                          "socialLinks": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "role"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "The staff members in display order.",
        "tags": [
          "staff"
        ],
        "x-pano-stability": "public"
      }
    }
  },
  "servers": [
    {
      "url": "/api/plugins/pano-plugin-staff-page"
    }
  ],
  "tags": [
    {
      "name": "staff"
    }
  ]
}
