        "description": "The API level this Pano implements.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "Error400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bad request: BAD_REQUEST",
        "x-pano-error-codes": [
          "BAD_REQUEST"
        ]
      },
      "Error401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Not logged in: NOT_LOGGED_IN",
        "x-pano-error-codes": [
          "NOT_LOGGED_IN"
        ]
      },
      "Error403": {
        "content": {
          "application/json": {
