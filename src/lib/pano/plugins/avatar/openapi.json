{
  "components": {
    "headers": {
      "PanoApiLevel": {
        "description": "The API level this Pano implements.",
        "schema": {
          "type": "integer"
        }
      }
    },
    "responses": {
      "Error400": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Bad request: BAD_REQUEST",
        "x-pano-error-codes": [
          "BAD_REQUEST"
        ]
      },
      "Error401": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Not logged in: NOT_LOGGED_IN",
        "x-pano-error-codes": [
          "NOT_LOGGED_IN"
        ]
      },
      "Error403": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Forbidden: INVALID_CSRF_TOKEN, NO_PERMISSION",
        "x-pano-error-codes": [
          "INVALID_CSRF_TOKEN",
          "NO_PERMISSION"
        ]
      },
      "Error429": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Too many requests: RATE_LIMIT_EXCEEDED",
        "x-pano-error-codes": [
          "RATE_LIMIT_EXCEEDED"
        ]
      },
      "Error500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Internal server error: INTERNAL_SERVER_ERROR",
        "x-pano-error-codes": [
          "INTERNAL_SERVER_ERROR"
        ]
      },
      "Error503": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Service unavailable: MAINTENANCE_MODE_ENABLED",
        "x-pano-error-codes": [
          "MAINTENANCE_MODE_ENABLED"
        ]
      }
    },
    "schemas": {
      "Error": {
        "description": "The body of every non-2xx answer.",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "A stable, declared code.",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "description": "Extra facts about the failure.",
                "type": "object"
              },
              "fields": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field name to code, for a rejected form.",
                "type": "object"
              },
              "message": {
                "description": "Optional English text.",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "description": "Where a list stands: page numbers start at 1, `pageSize` is at most 100.",
        "properties": {
          "number": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "description": "A site session token, sent by a server-side front-end that holds a front-end key. Not valid on the panel API.",
        "scheme": "bearer",
        "type": "http"
      },
      "sessionCookie": {
        "description": "The session cookie set by login. A mutation also repeats the `pano_csrf_token` cookie in the `X-CSRF-Token` header. Behind a plain-http origin the cookie names end in `_http`.",
        "in": "cookie",
        "name": "pano_auth_token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "The public API of the plugin pano-plugin-avatar, served below /api/plugins/pano-plugin-avatar.",
    "summary": "Pano plugin API: pano-plugin-avatar",
    "title": "Pano plugin API: pano-plugin-avatar",
    "version": "1",
    "x-pano-api-level": 1,
    "x-pano-plugin-id": "pano-plugin-avatar",
    "x-pano-scope": "plugin"
  },
  "openapi": "3.1.0",
  "paths": {
    "/avatar": {
      "post": {
        "operationId": "UpdateAvatar",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "avatarType": {
                    "type": "string"
                  }
                },
                "required": [
                  "avatarType"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerAuth": []
          }
        ],
        "summary": "Sets the signed-in player's avatar source; a multipart upload carries the file for the custom source.",
        "tags": [
          "avatar"
        ],
        "x-pano-stability": "public"
      }
    },
    "/avatar/config": {
      "get": {
        "operationId": "GetAvatarConfig",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "allowedSources": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "allowedTypes": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "customSources": {
                      "items": {
                        "properties": {
                          "identifierField": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "urlTemplate": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "identifierField",
                          "title",
                          "urlTemplate"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "maxSizeMb": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "allowedSources",
                    "allowedTypes",
                    "customSources",
                    "maxSizeMb"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "What avatars players may choose: size limit, file types and sources.",
        "tags": [
          "avatar"
        ],
        "x-pano-stability": "public"
      }
    },
    "/avatar/image/{fileName}": {
      "get": {
        "operationId": "GetAvatarImage",
        "parameters": [
          {
            "in": "path",
            "name": "fileName",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found: NOT_FOUND",
            "x-pano-error-codes": [
              "NOT_FOUND"
            ]
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "An uploaded avatar file.",
        "tags": [
          "avatar"
        ],
        "x-pano-stability": "public"
      }
    },
    "/avatar/user/{username}": {
      "get": {
        "operationId": "GetAvatar",
        "parameters": [
          {
            "in": "path",
            "name": "username",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "avatarType": {
                      "type": "string"
                    },
                    "fileName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "avatarType",
                    "fileName"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found: NOT_FOUND",
            "x-pano-error-codes": [
              "NOT_FOUND"
            ]
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "Which avatar source a player uses, and the file name of an uploaded avatar.",
        "tags": [
          "avatar"
        ],
        "x-pano-stability": "public"
      }
    }
  },
  "servers": [
    {
      "url": "/api/plugins/pano-plugin-avatar"
    }
  ],
  "tags": [
    {
      "name": "avatar"
    }
  ]
}
