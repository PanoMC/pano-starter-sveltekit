            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      }
    }
