        "description": "Where a list stands: page numbers start at 1, `pageSize` is at most 100.",
        "properties": {
          "number": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
