    "schemas": {
      "Error": {
        "description": "The body of every non-2xx answer.",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "A stable, declared code.",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "description": "Extra facts about the failure.",
                "type": "object"
              },
              "fields": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field name to code, for a rejected form.",
                "type": "object"
              },
              "message": {
                "description": "Optional English text.",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "description": "Where a list stands: page numbers start at 1, `pageSize` is at most 100.",
        "properties": {
          "number": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The public API of the plugin pano-plugin-slider, served below /api/plugins/pano-plugin-slider.",
    "summary": "Pano plugin API: pano-plugin-slider",
    "title": "Pano plugin API: pano-plugin-slider",
    "version": "1",
    "x-pano-api-level": 1,
    "x-pano-plugin-id": "pano-plugin-slider",
    "x-pano-scope": "plugin"
  },
  "openapi": "3.1.0",
  "paths": {
    "/items": {
      "get": {
        "operationId": "GetSliderItems",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "properties": {
                          "active": {
                            "type": "boolean"
                          },
                          "createdAt": {
                            "type": "integer"
                          },
                          "id": {
                            "type": "integer"
                          },
                          "imageFileName": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "imageUrl": {
                            "type": "string"
                          },
                          "itemOrder": {
                            "type": "integer"
                          },
                          "linkUrl": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "openInNewTab": {
                            "type": "boolean"
                          },
                          "subtitle": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "title": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "active",
                          "id",
                          "imageUrl",
                          "title"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "settings": {
                      "properties": {
                        "autoSlide": {
                          "type": "boolean"
                        },
                        "blurAmount": {
                          "type": "integer"
                        },
                        "captionBackground": {
                          "type": "string"
                        },
                        "captionOpacity": {
                          "type": "number"
                        },
                        "captionStyle": {
                          "type": "string"
                        },
                        "controls": {
                          "type": "boolean"
                        },
                        "homepageOnly": {
                          "type": "boolean"
                        },
                        "indicators": {
                          "type": "boolean"
                        },
                        "interval": {
                          "type": "integer"
                        },
                        "pauseOnHover": {
                          "type": "boolean"
                        },
                        "renderHook": {
                          "type": "string"
                        },
                        "subtitleColor": {
                          "type": "string"
                        },
                        "titleColor": {
                          "type": "string"
                        },
                        "titleTag": {
                          "type": "string"
                        },
                        "transition": {
                          "type": "string"
                        },
                        "wrap": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "autoSlide",
                        "blurAmount",
                        "captionBackground",
                        "captionOpacity",
                        "captionStyle",
                        "controls",
                        "homepageOnly",
                        "indicators",
                        "interval",
                        "pauseOnHover",
                        "renderHook",
                        "subtitleColor",
                        "titleColor",
                        "titleTag",
                        "transition",
                        "wrap"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "items",
                    "settings"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "The active slides and the look of the slider.",
        "tags": [
          "slider"
        ],
        "x-pano-stability": "public"
      }
    },
    "/items/image/{fileName}": {
      "get": {
        "operationId": "GetSliderImage",
        "parameters": [
          {
            "in": "path",
            "name": "fileName",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "thumbnail",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Not found: NOT_FOUND",
            "x-pano-error-codes": [
              "NOT_FOUND"
            ]
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "A slide image, or its thumbnail with ?thumbnail=true.",
        "tags": [
          "slider"
        ],
        "x-pano-stability": "public"
      }
    }
  },
  "servers": [
    {
      "url": "/api/plugins/pano-plugin-slider"
    }
  ],
  "tags": [
    {
      "name": "slider"
    }
  ]
