    "schemas": {
      "Error": {
        "description": "The body of every non-2xx answer.",
        "properties": {
          "error": {
            "properties": {
              "code": {
                "description": "A stable, declared code.",
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "details": {
                "additionalProperties": true,
                "description": "Extra facts about the failure.",
                "type": "object"
              },
              "fields": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Field name to code, for a rejected form.",
                "type": "object"
              },
              "message": {
                "description": "Optional English text.",
                "type": "string"
              }
            },
            "required": [
              "code"
            ],
            "type": "object"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "Page": {
        "description": "Where a list stands: page numbers start at 1, `pageSize` is at most 100.",
        "properties": {
          "number": {
            "minimum": 1,
            "type": "integer"
          },
          "size": {
            "minimum": 1,
            "type": "integer"
          },
          "totalItems": {
            "minimum": 0,
            "type": "integer"
          },
          "totalPages": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "number",
          "size",
          "totalItems",
          "totalPages"
        ],
        "type": "object"
      }
    }
  },
  "info": {
