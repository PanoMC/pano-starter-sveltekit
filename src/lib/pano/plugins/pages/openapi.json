                          }
                        },
                        "required": [
                          "active",
                          "htmlContent",
                          "id",
                          "title",
                          "url"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
              "Pano-Api-Level": {
                "$ref": "#/components/headers/PanoApiLevel"
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "500": {
            "$ref": "#/components/responses/Error500"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "summary": "The active custom pages.",
        "tags": [
          "pages"
        ],
        "x-pano-stability": "public"
      }
