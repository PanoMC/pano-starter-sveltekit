                        },
                        "url": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "active",
                        "htmlContent",
                        "id",
                        "title",
                        "url"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "page"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Success",
            "headers": {
