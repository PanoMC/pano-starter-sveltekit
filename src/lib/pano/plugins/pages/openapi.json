      "Error500": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Internal server error: INTERNAL_SERVER_ERROR",
        "x-pano-error-codes": [
          "INTERNAL_SERVER_ERROR"
