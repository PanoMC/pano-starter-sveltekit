{
  "name": "pano-starter-sveltekit",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A headless SvelteKit site for Pano. Every request to Pano goes through this server (BFF); the session token never reaches browser JavaScript.",
  "scripts": {
    "prepare": "svelte-kit sync || echo ''",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "bun index.js",
    "test": "bun test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json && bun scripts/pano-client.mjs check",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "package": "bun run build && bun scripts/package.mjs",
    "e2e": "bun e2e/run.mjs",
    "pano:pull": "bun scripts/pano-client.mjs pull"
  },
  "dependencies": {
    "@panomc/client": "1.0.0-dev.62"
  },
  "devDependencies": {
    "@panomc/client-gen": "1.0.0-dev.62",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "playwright": "1.64.1",
    "prettier": "~3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
